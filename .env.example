# Copy to .env.local for local development. Never commit real values.

# Claude API key (https://console.anthropic.com). Without it, Brandrail runs
# rule-based checks only and clearly labels AI checks as unavailable.
ANTHROPIC_API_KEY=

# Postgres connection string (e.g. Neon via Vercel Storage).
# Leave empty locally to use an embedded PGlite database in ./.data
DATABASE_URL=

# Optional model overrides
BRANDRAIL_REVIEW_MODEL=claude-sonnet-5-5
BRANDRAIL_FAST_MODEL=claude-haiku-5-5
