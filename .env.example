# Copy to .env.local for local development. Never commit real values.

# AI provider (pick one; Claude wins if both are set). Without either, Brandrail runs
# rule-based checks only and labels the AI review as off.
#  - Free: Google Gemini API key from https://aistudio.google.com (no card needed)
GEMINI_API_KEY=
#  - Paid: Anthropic Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Postgres connection string (e.g. Neon via Vercel Storage).
# Leave empty locally to use an embedded PGlite database in ./.data
DATABASE_URL=

# Optional model overrides
BRANDRAIL_GEMINI_MODEL=gemini-3.5-flash
BRANDRAIL_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
BRANDRAIL_REVIEW_MODEL=claude-sonnet-5-5
BRANDRAIL_FAST_MODEL=claude-haiku-5-5
